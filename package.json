{
  "name": "scratch-gui",
  "version": "1.2.0",
  "description": "Graphical User Interface for creating and running Scratch 3.0 projects (Bilup version)",
  "author": "Bilup",
  "license": "GPL-3.0",
  "homepage": "https://github.com/Bilup/scratch-gui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bilup/scratch-gui.git"
  },
  "main": "./dist/scratch-gui.js",
  "scripts": {
    "postinstall": "patch-package || echo 'skipping patch-package (not installed)'",
    "build": "npm run prepublish && npm run clean && cross-env NODE_ENV=production webpack --colors --bail",
    "clean": "rimraf ./build && mkdirp build && rimraf ./dist && mkdirp dist",
    "setup": "npm install",
    "reinstall": "rm -rf node_modules package-lock.json && npm i && npm run link",
    "deploy": "NODE_ENV=production npm run build && touch build/.nojekyll && cp -r functions build/functions && gh-pages -t -d build -m \"Build for $(git log --pretty=format:%H -n1)\"",
    "prepublish": "node scripts/prepublish.mjs",
    "i18n:push": "tx-push-src scratch-editor interface translations/en.json",
    "i18n:src": "rimraf ./translations/messages/src && babel src > tmp.js && rimraf tmp.js && build-i18n-src ./translations/messages/src ./translations/",
    "start": "webpack-dev-server",
    "lint": "eslint .",
    "test": "npm run test:lint && npm run test:unit && npm run build && npm run test:integration",
    "test:integration": "jest --maxWorkers=4 test[\\\\/]integration",
    "test:lint": "eslint . --ext .js,.jsx",
    "test:collab": "jest --config jest.collab.config.js",
    "test:unit": "jest test[\\\\/]unit[\\\\/]addons",
    "test:smoke": "jest --runInBand test[\\\\/]smoke",
    "watch": "webpack --colors --watch",
    "link": "npm link scratch-vm scratch-blocks scratch-render scratch-paint"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@bilup/scratch-l10n": "github:Bilup/scratch-l10n#develop-builds",
    "@bilup/scratch-storage": "github:Bilup/scratch-storage#develop-builds",
    "@bilup/scratch-svg-renderer": "github:Bilup/scratch-svg-renderer#develop-builds",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "@microbit/microbit-universal-hex": "0.2.2",
    "@turbowarp/jszip": "^3.11.1",
    "@turbowarp/nanolog": "^0.2.0",
    "@turbowarp/startaudiocontext": "^1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "arraybuffer-loader": "^1.0.6",
    "autoprefixer": "^9.0.1",
    "balance-text": "3.3.1",
    "base64-loader": "1.0.0",
    "bowser": "1.9.4",
    "caniuse-lite": "^1.0.30001766",
    "classnames": "2.2.6",
    "computed-style-to-inline-style": "3.0.0",
    "cookie": "0.5.0",
    "copy-webpack-plugin": "6.4.1",
    "core-js": "^2.6.12",
    "css-loader": "^1.0.0",
    "dapjs": "2.3.0",
    "fake-indexeddb": "^6.2.5",
    "format-message": "^6.2.4",
    "fractch": "0.7.8",
    "get-float-time-domain-data": "0.1.0",
    "get-user-media-promise": "1.1.4",
    "https-proxy-agent": "^9.0.0",
    "immutable": "3.8.2",
    "intl": "1.2.5",
    "intl-messageformat": "^2.2.0",
    "isomorphic-git": "^1.34.0",
    "js-base64": "2.4.9",
    "jsoneditor": "10.4.2",
    "just-bash": "^3.1.0",
    "keymirror": "0.1.1",
    "lodash.bindall": "4.4.0",
    "lodash.debounce": "4.0.8",
    "lodash.defaultsdeep": "4.6.1",
    "lodash.omit": "4.5.0",
    "lodash.throttle": "4.0.1",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.6.0",
    "monaco-editor": "^0.34.1",
    "nanoid": "^3.3.0",
    "omggif": "1.0.9",
    "papaparse": "5.3.0",
    "peerjs": "1.3.0",
    "postcss-import": "^12.0.0",
    "postcss-loader": "^3.0.0",
    "postcss-simple-vars": "^5.0.1",
    "prop-types": "^15.5.10",
    "query-string": "^5.1.1",
    "raw-loader": "^0.5.1",
    "react": "^16.0.0",
    "react-contextmenu": "2.9.4",
    "react-dom": "^16.0.0",
    "react-draggable": "3.0.5",
    "react-ga": "2.5.3",
    "react-intl": "2.9.0",
    "react-markdown": "^8.0.0",
    "react-modal": "3.9.1",
    "react-popover": "0.5.10",
    "react-redux": "5.0.7",
    "react-responsive": "5.0.0",
    "react-router-dom": "^6.30.4",
    "react-string-replace": "^0.4.4",
    "react-style-proptype": "3.2.2",
    "react-tabs": "2.3.0",
    "react-tooltip": "3.8.0",
    "react-virtualized": "9.20.1",
    "redux": "3.7.2",
    "redux-throttle": "0.1.1",
    "remark-gfm": "^2.0.0",
    "rotur-sdk": "github:Bilup/accounts-sdk#main",
    "scratch-audio": "github:Bilup/scratch-audio#develop-builds",
    "scratch-blocks": "github:Bilup/new-scratch-blocks#develop-builds",
    "scratch-parser": "github:Bilup/scratch-parser#main",
    "scratch-paint": "github:Bilup/scratch-paint#develop",
    "scratch-render": "github:Bilup/scratch-render#develop-builds",
    "scratch-vm": "github:Bilup/scratch-vm#develop-builds",
    "socks-proxy-agent": "^10.0.0",
    "style-loader": "^0.23.0",
    "text-encoding": "0.7.0",
    "to-style": "1.3.3",
    "wav-encoder": "1.3.0",
    "xhr": "2.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/cli": "7.14.8",
    "@babel/core": "7.14.8",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-object-rest-spread": "7.14.7",
    "@babel/plugin-syntax-dynamic-import": "7.2.0",
    "@babel/plugin-transform-async-to-generator": "7.14.5",
    "@babel/preset-env": "7.14.8",
    "@babel/preset-react": "^7.14.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "10.1.0",
    "babel-loader": "8.3.0",
    "chromedriver": "117.0.3",
    "cli-progress": "^3.12.0",
    "enzyme": "3.10.0",
    "enzyme-adapter-react-16": "1.15.7",
    "eslint": "8.55.0",
    "eslint-config-scratch": "9.0.3",
    "eslint-import-resolver-webpack": "0.11.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jest": "22.17.0",
    "eslint-plugin-react": "7.33.2",
    "cross-env": "^7.0.3",
    "exports-loader": "0.7.0",
    "file-loader": "6.2.0",
    "gh-pages": "3.2.3",
    "html-webpack-plugin": "^4.2.0",
    "http-proxy-agent": "^9.0.0",
    "imports-loader": "0.8.0",
    "jest": "21.2.1",
    "jest-junit": "7.0.0",
    "less": "^4.1.0",
    "less-loader": "^7.3.0",
    "mkdirp": "1.0.3",
    "patch-package": "^8.0.1",
    "raf": "3.4.1",
    "react-test-renderer": "16.14.0",
    "redux-mock-store": "1.5.3",
    "rimraf": "2.7.1",
    "selenium-webdriver": "3.6.0",
    "ts-loader": "^8.4.0",
    "typescript": "^4.9.0",
    "uglifyjs-webpack-plugin": "1.3.0",
    "url-loader": "4.1.1",
    "web-audio-test-api": "0.5.2",
    "webpack": "4.47.0",
    "webpack-cli": "3.3.12",
    "webpack-dev-server": "3.11.2",
    "worker-loader": "^2.0.0",
    "yauzl": "2.10.0"
  },
  "jest": {
    "setupFiles": [
      "raf/polyfill",
      "<rootDir>/test/helpers/enzyme-setup.js"
    ],
    "testPathIgnorePatterns": [
      "src/test.js"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/test/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/test/__mocks__/styleMock.js",
      "editor-msgs(\\.js)?$": "<rootDir>/test/__mocks__/editor-msgs-mock.js",
      "^scratch-render-fonts$": "<rootDir>/src/lib/tw-scratch-render-fonts",
      "^!arraybuffer-loader!.*$": "<rootDir>/test/__mocks__/arrayBufferMock.js",
      "^!raw-loader!.*$": "<rootDir>/test/__mocks__/fileMock.js",
      "^scratch-audio$": "<rootDir>/node_modules/scratch-audio/src/index.js",
      "^@turbowarp/scratch-svg-renderer$": "<rootDir>/node_modules/@turbowarp/scratch-svg-renderer",
      "^entities/decode$": "<rootDir>/node_modules/.pnpm/entities@6.0.1/node_modules/entities/dist/commonjs/decode.js",
      "^entities/escape$": "<rootDir>/node_modules/.pnpm/entities@6.0.1/node_modules/entities/dist/commonjs/escape.js",
      "^domhandler$": "<rootDir>/node_modules/.pnpm/domhandler@4.3.1/node_modules/domhandler/lib/index.js",
      "^domhandler/lib/(.*)$": "<rootDir>/node_modules/.pnpm/domhandler@4.3.1/node_modules/domhandler/lib/$1"
    },
    "testEnvironment": "jsdom",
    "transformIgnorePatterns": [
      "/node_modules/(?!(scratch-audio|scratch-parser|fractch|pify|isomorphic-git|rotur-sdk|@vernier/godirect|@chenglou/pretext)/)"
    ],
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs)$": "<rootDir>/test/helpers/babel7-jest-transformer.js"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "chromedriver",
      "fsevents",
      "scratch-audio",
      "scratch-blocks",
      "scratch-paint",
      "scratch-render",
      "scratch-vm"
    ],
    "overrides": {
      "webpack@4.47.0>terser-webpack-plugin": "^1.4.1",
      "cheerio": "1.0.0-rc.12",
      "brace-expansion": "1.1.11",
      "rotur-sdk": "github:Bilup/accounts-sdk#main",
      "escape-string-regexp": "4.0.0"
    }
  }
}
